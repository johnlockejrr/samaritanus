# Copy to .env to override defaults. The app starts fine without this file.
# Docker Compose expands ${VAR:-default} from here.

# Host port for the container (API + web UI on one port).
APP_PORT=8000

# Comma-separated browser origins. Leave empty when the UI is served by the API.
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# HTTP hardening
RATE_LIMIT_PER_MINUTE=60
# true behind Nginx or Traefik so the client IP comes from X-Forwarded-For.
TRUST_PROXY=false
# Optional shared secret on /api/* except /api/health. Empty = open.
API_KEY=
SEARCH_CACHE_MAX_AGE=60
# Interactive API docs. Keep false in production.
DOCS_ENABLED=false

# Optional. Share the rate limit across workers. Empty = in-memory limiter.
# REDIS_URL=redis://redis:6379

# Local overrides (dev.sh / bare uvicorn). The container sets these itself.
# SEARCH_DB=data/samaritanus.db
# STATIC_DIR=dist
